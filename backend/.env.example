# Copiar a .env y completar valores.

# Postgres local:
# DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@localhost:5432/whatsapp_masivo
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_base

JWT_SECRET=tu_jwt_secret_muy_seguro

# Solo para crear el PRIMER usuario admin cuando la base esta vacia (POST /api/auth/bootstrap).
SETUP_SECRET=cambia_esto_por_un_secreto_largo_minimo_16

# Railway asigna PORT automaticamente; en local puede omitirse o usar 3001.
PORT=3001

# Mercado Pago
MP_ACCESS_TOKEN=tu_access_token_de_mercadopago
MP_PUBLIC_KEY=tu_public_key_de_mercadopago

# URLs publicas cuando este desplegado
APP_URL=https://tu-backend.up.railway.app
FRONTEND_URL=https://tu-frontend.up.railway.app

# ─── Meta Cloud API (WhatsApp) ───────────────────────────────────────────────
# Obtener desde: https://developers.facebook.com → Tu App → WhatsApp → Configuracion de API
#
# ID del numero de telefono registrado en Meta
META_PHONE_NUMBER_ID=123456789012345
#
# Token de acceso permanente (System User Token recomendado para produccion)
# En desarrollo se puede usar el token temporal de 24hs del panel de Meta
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx
#
# Version de la API de Graph (actualizar cuando Meta saque nueva version LTS)
META_API_VERSION=v21.0
#
# Token secreto que vos defines para verificar el webhook de Meta
# Puede ser cualquier string largo y aleatorio
META_WEBHOOK_VERIFY_TOKEN=mi_token_secreto_webhook_largo
